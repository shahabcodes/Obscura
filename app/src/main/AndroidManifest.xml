<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Obscura is offline by design. Strip any network permission a library tries to add;
         the verify*NoNetwork Gradle task double-checks the merged manifest on every build. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Long imports keep running in the background with a progress notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the vault hide other apps' overlays while it is on screen (Android 12+). -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <application
        android:name=".ObscuraApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Obscura"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".importer.ImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".backup.BackupService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".export.ExportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- One-time share links. Not exported: only apps handed a link may read that file. -->
        <provider
            android:name=".export.ShareProvider"
            android:authorities="com.shahaabapps.Obscura.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
